{
  "name": "tauri-native-react-native-example",
  "version": "0.0.1",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "ios": "nub run prebuild && expo run:ios",
    "android": "nub run prebuild:android && expo run:android",
    "prebuild": "expo prebuild --platform ios",
    "prebuild:android": "expo prebuild --platform android",
    "prebuild:clean:android": "expo prebuild --clean --platform android",
    "prebuild:clean:ios": "expo prebuild --clean --platform ios",
    "test:e2e:ios": "maestro test --platform ios .maestro/ios-integration.yaml",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tauri-native/react-native": "workspace:*",
    "expo": "~57.0.19",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.10",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
