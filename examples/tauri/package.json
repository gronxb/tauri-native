{
  "name": "tauri-native-tauri-example",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:tauri-native": "nub --cwd ../../packages/cli run build",
    "export:ios": "nub run build:tauri-native && tauri-native export ios",
    "test": "cargo test --workspace --manifest-path ../../Cargo.toml",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@tauri-native/cli": "workspace:*",
    "@tauri-apps/cli": "^2",
    "typescript": "7.0.2",
    "vite": "^8.0.16"
  }
}
