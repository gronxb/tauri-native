{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tauri-native Tauri example",
  "version": "0.1.0",
  "identifier": "dev.tauri-native.example",
  "build": {
    "beforeDevCommand": "nub run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "nub run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "tauri-native Tauri example",
        "width": 760,
        "height": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
