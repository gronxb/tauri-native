source 'https://cdn.cocoapods.org/'

plugin 'cocoapods-lynx-library'
require 'json'

platform :ios, '13.0'
use_modular_headers!

cli_package_json = `node --print "require.resolve('@tauri-native/cli/package.json')"`.strip
abort('Could not resolve @tauri-native/cli') unless $?.success?
cli_package = JSON.parse(File.read(cli_package_json))
tauri_native_cli = File.expand_path(
  cli_package.fetch('bin').fetch('tauri-native'),
  File.dirname(cli_package_json)
)
tauri_dir = File.expand_path('../../tauri/src-tauri', __dir__)
output_dir = File.expand_path('tauri-native', __dir__)
abort('Failed to package the Tauri microfrontend') unless system(
  'node',
  tauri_native_cli,
  'build',
  'ios',
  '--tauri-dir',
  tauri_dir,
  '--output-dir',
  output_dir
)

target 'Hello-Lynx' do
  pod 'TauriNativeGenerated', :path => output_dir
  pod 'Lynx', '4.0.1', :subspecs => ['Framework']
  pod 'PrimJS', '4.0.0', :subspecs => ['quickjs', 'napi']
  pod 'XElement', '4.0.1'

  use_lynx_library!
end
