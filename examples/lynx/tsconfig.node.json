{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "composite": true,
    "module": "node16",
    "moduleResolution": "node16",
    "erasableSyntaxOnly": true,
    "lib": [
      "es2023"
    ],
    "target": "es2022",
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "./lynx.config.ts",
    "scripts/**/*.ts"
  ]
}
