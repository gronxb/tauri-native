{
  "name": "tauri-native-lynx-example",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rspeedy build --mode production",
    "build:ios": "rspeedy build --mode production && cp dist/main.lynx.bundle ios/main.lynx.bundle",
    "dev": "rspeedy dev",
    "pods": "nub run build:ios && cd ios && BUNDLE_PATH=vendor/bundle bundle install && BUNDLE_PATH=vendor/bundle bundle exec pod install",
    "test:e2e:ios": "maestro test --platform ios .maestro/ios-integration.yaml",
    "typecheck": "tsc --build"
  },
  "dependencies": {
    "@lynx-js/react": "^0.125.0",
    "@lynx-js/lynx-ui": "^3.136.0",
    "@tauri-native/lynx": "workspace:*"
  },
  "devDependencies": {
    "@lynx-js/preact-devtools": "5.0.1-20260721114100-d7da994",
    "@lynx-js/qrcode-rsbuild-plugin": "^0.6.0",
    "@lynx-js/react-rsbuild-plugin": "^0.19.1",
    "@lynx-js/rspeedy": "^0.16.5",
    "@lynx-js/types": "4.1.0",
    "@rsbuild/plugin-type-check": "1.6.0",
    "@tauri-native/cli": "workspace:*",
    "@types/react": "^19.2.18",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
