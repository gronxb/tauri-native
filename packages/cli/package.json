{
  "name": "@tauri-native/cli",
  "version": "0.1.0",
  "description": "Export a Tauri microfrontend and its Rust core for native hosts",
  "type": "module",
  "bin": {
    "tauri-native": "./dist/index.mjs"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "native/Cargo.toml",
    "native/Cargo.lock",
    "native/src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "tsdown",
    "test": "nub run build && node --experimental-strip-types --test test/*.test.ts && nub run test:package",
    "test:export:spike": "node --experimental-strip-types test/native-export/spike.mjs",
    "test:export:contract": "node --experimental-strip-types test/native-export/contract.mjs",
    "test:export:ios": "nub run build && node --experimental-strip-types test/native-export/ios.mjs",
    "test:export:android": "nub run build && node --experimental-strip-types test/native-export/android.mjs",
    "test:export:async": "nub run build && node --experimental-strip-types test/native-export/async.mjs",
    "test:types": "nub run build && node --experimental-strip-types test/types/run.mjs",
    "test:events": "node --experimental-vm-modules --test test/events/protocol.mjs",
    "test:events:export": "nub run build && node --experimental-strip-types test/events/export.mjs",
    "test:doctor": "nub run build && node --experimental-strip-types --test test/doctor.test.ts",
    "test:watch": "nub run build && node --experimental-strip-types test/watch/run.mjs",
    "test:package": "node ../../scripts/verify-package.mjs",
    "typecheck": "tsc --noEmit",
    "test:external-consumer:export": "nub run build && node --experimental-strip-types test/feature/export.mjs",
    "test:external-consumer": "nub run build && node --experimental-strip-types test/feature/run.mjs"
  },
  "dependencies": {
    "@clack/core": "^1.4.3",
    "commander": "^15.0.0"
  },
  "keywords": [
    "android",
    "ios",
    "react-native",
    "rust",
    "tauri"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gronxb/tauri-native.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/gronxb/tauri-native#readme",
  "bugs": {
    "url": "https://github.com/gronxb/tauri-native/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "experimental"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsdown": "^0.22.14",
    "typescript": "7.0.2"
  }
}
