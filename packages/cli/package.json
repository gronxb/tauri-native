{
  "name": "@tauri-native/cli",
  "version": "1.0.0-rc.0",
  "description": "Export a Tauri microfrontend and its Rust core for native hosts",
  "type": "module",
  "bin": {
    "tauri-native": "./dist/index.mjs"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "native/Cargo.toml",
    "native/Cargo.lock",
    "native/src",
    "runtime/Cargo.toml",
    "runtime/src",
    "runtime/android",
    "runtime/ios",
    "runtime/tauri_native_runtime.h",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "tsdown",
    "test": "nub run build && node --experimental-strip-types --test test/*.test.ts test/runtime/*.test.ts && nub run test:package",
    "test:export:spike": "node --experimental-strip-types test/native-export/spike.ts",
    "test:runtime:baseline": "node --experimental-strip-types test/runtime/baseline.ts",
    "test:runtime:retained": "node --experimental-strip-types test/runtime/retained.ts",
    "test:runtime:retained:lynx:ios": "node --experimental-strip-types test/runtime/compose-ios.ts lynx retained",
    "test:runtime:retained:lynx:android": "node --experimental-strip-types test/runtime/compose-android.ts lynx retained",
    "test:runtime:retained:rn:ios": "node --experimental-strip-types test/runtime/compose-ios.ts react-native retained",
    "test:runtime:retained:rn:android": "node --experimental-strip-types test/runtime/compose-android.ts react-native retained",
    "test:runtime:ios": "node --experimental-strip-types test/runtime/mobile.ts ios",
    "test:runtime:compose:rn:ios": "node --experimental-strip-types test/runtime/compose-ios.ts react-native",
    "test:runtime:compose:rn:android": "node --experimental-strip-types test/runtime/compose-android.ts react-native",
    "test:runtime:compose:ios": "node --experimental-strip-types test/runtime/compose-ios.ts",
    "test:runtime:compose:android": "node --experimental-strip-types test/runtime/compose-android.ts",
    "test:runtime:android": "node --experimental-strip-types test/runtime/mobile.ts android",
    "test:runtime:plugins:ios": "node --experimental-strip-types test/runtime/plugins.ts ios",
    "test:runtime:plugins:android": "node --experimental-strip-types test/runtime/plugins.ts android",
    "test:runtime:plugins:desktop": "node --experimental-strip-types test/runtime/baseline.ts plugins",
    "test:runtime:portable:ios": "nub run build && node --experimental-strip-types test/runtime/portable.ts ios",
    "test:runtime:portable:android": "nub run build && node --experimental-strip-types test/runtime/portable.ts android",
    "test:runtime:slices": "nub run build && node --experimental-strip-types test/runtime/slices.ts",
    "test:export:contract": "node --experimental-strip-types test/native-export/contract.ts",
    "test:export:ios": "nub run build && node --experimental-strip-types test/native-export/ios.ts",
    "test:export:android": "nub run build && node --experimental-strip-types test/native-export/android.ts",
    "test:export:async": "nub run build && node --experimental-strip-types test/native-export/async.ts",
    "test:types": "nub run build && node --experimental-strip-types test/types/run.ts",
    "test:events": "node --experimental-strip-types --experimental-vm-modules --test test/events/protocol.ts",
    "test:events:export": "nub run build && node --experimental-strip-types test/events/export.ts",
    "test:doctor": "nub run build && node --experimental-strip-types --test test/doctor.test.ts",
    "test:watch": "nub run build && node --experimental-strip-types test/watch/run.ts",
    "test:package": "node --experimental-strip-types ../../scripts/verify-package.ts",
    "typecheck": "tsc --noEmit",
    "test:external-consumer:export": "nub run build && node --experimental-strip-types test/feature/export.ts",
    "test:external-consumer": "nub run build && node --experimental-strip-types test/feature/run.ts",
    "test:onboarding": "nub run build && node --experimental-strip-types test/feature/uninstall.ts"
  },
  "dependencies": {
    "@clack/core": "^1.4.3",
    "commander": "^15.0.0"
  },
  "keywords": [
    "android",
    "ios",
    "react-native",
    "rust",
    "tauri"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gronxb/tauri-native.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/gronxb/tauri-native#readme",
  "bugs": {
    "url": "https://github.com/gronxb/tauri-native/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "experimental"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsdown": "^0.22.14",
    "typescript": "7.0.2"
  }
}
