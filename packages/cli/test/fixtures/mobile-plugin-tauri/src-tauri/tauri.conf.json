{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tauri Mobile Fieldnotes",
  "version": "0.1.0",
  "identifier": "dev.taurinative.mobilefieldnotes",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tauri Mobile Fieldnotes",
        "width": 600,
        "height": 400
      }
    ]
  },
  "bundle": {
    "active": false
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": [
            "tauri-fieldnotes"
          ]
        }
      ],
      "desktop": {
        "schemes": [
          "tauri-fieldnotes"
        ]
      }
    }
  }
}
