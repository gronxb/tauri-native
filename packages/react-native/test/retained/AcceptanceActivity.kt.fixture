package dev.taurinative.mobilefieldnotes

import android.content.Intent
import android.webkit.WebView
import android.view.ViewGroup
import android.widget.Button
import android.widget.FrameLayout
import android.widget.LinearLayout
import dev.taurinative.runtime.RuntimeSession
import com.facebook.react.modules.core.PermissionListener
import java.io.File
import org.json.JSONObject

// Test layout and telemetry only. The generated SDK Activity owns startup and forwarding.
class AcceptanceActivity : TauriNativeActivity() {
  private val host get() = tauriReactHost
  private lateinit var observedWebView: WebView
  private var destroyed = false
  private var generation = 0
  private var resumed = 0
  private var paused = 0
  private var stopped = 0
  private var listenersAfterRelease = -1
  private var hostClosed = false
  private var retireOnPause = false
  private var permissionRetirement: JSONObject? = null
  private val receivedIntents = org.json.JSONArray()
  private val rnPermissionRequests = org.json.JSONArray()
  private val rnPermissionResults = org.json.JSONArray()

  private var originalParent: android.view.ViewParent? = null
  private var lastParent: android.view.ViewParent? = null
  private var originalClient: android.webkit.WebViewClient? = null
  private var originalChromeClient: android.webkit.WebChromeClient? = null
  private var documentOrigin: String? = null
  private val documentToken = java.util.UUID.randomUUID().toString()
  private val viewTransitions = org.json.JSONArray()

  override fun isTauriDocumentReady(webView: WebView): Boolean {
    val baseline = File(applicationInfo.dataDir, "runtime-report.json")
    return super.isTauriDocumentReady(webView) && baseline.exists() && JSONObject(baseline.readText()).optBoolean("passed")
  }
  override fun createReactContainer(webView: WebView): ViewGroup {
      observedWebView = webView
      val baseline = File(applicationInfo.dataDir, "runtime-report.json")
      android.util.Log.i("TauriReactAcceptance", JSONObject().put("kind", "baseline").put("report", JSONObject(baseline.readText())).toString())
      (webView.parent as? ViewGroup)?.removeView(webView)
      val layout = LinearLayout(this@AcceptanceActivity).apply { orientation = LinearLayout.VERTICAL; setPadding(0, 80, 0, 60) }
      layout.addView(webView, LinearLayout.LayoutParams(-1, 0, 1f))
      val container = FrameLayout(this@AcceptanceActivity)
      val remount = Button(this@AcceptanceActivity).apply {
        text = "Reload RN"
        setOnClickListener {
          reloadRenderer()
          record()
        }
      }
      val controls = LinearLayout(this@AcceptanceActivity)
      controls.addView(remount, LinearLayout.LayoutParams(0, -2, 1f))
      val close = Button(this@AcceptanceActivity).apply {
        text = "Close RN"
        setOnClickListener {
          host!!.close(); hostClosed = true
          layout.removeView(container); layout.removeView(controls)
          record()
        }
      }
      controls.addView(close, LinearLayout.LayoutParams(0, -2, 1f))
      val arm = Button(this@AcceptanceActivity).apply {
        text = "Retire on pause"
        setOnClickListener { retireOnPause = true; record() }
      }
      controls.addView(arm, LinearLayout.LayoutParams(0, -2, 1f))
      layout.addView(controls)
      layout.addView(container, LinearLayout.LayoutParams(-1, 0, 2f))
      setContentView(layout)
      originalParent = webView.parent
      originalClient = webView.webViewClient; originalChromeClient = webView.webChromeClient
      webView.evaluateJavascript("Object.defineProperty(globalThis, '__tauriNativeViewAcceptanceDocument', { value: '$documentToken' }); performance.timeOrigin") { documentOrigin = it }
      return container
  }
  override fun onReactHostAttached() {
      super.onReactHostAttached()
      generation++
      val telemetry = object : Runnable { override fun run() { if (!destroyed) { record(); observedWebView.postDelayed(this, 100) } } }
      observedWebView.post(telemetry)
  }
  private fun reloadRenderer() {
    host!!.reload()
    generation++
    listenersAfterRelease = RuntimeSession.status().getInt("listeners")
  }
  private fun record() {
    if (originalParent != null && lastParent != observedWebView.parent) {
      lastParent = observedWebView.parent
      val parent = lastParent!!.javaClass.name
      observedWebView.evaluateJavascript("({ timeOrigin: performance.timeOrigin, token: globalThis.__tauriNativeViewAcceptanceDocument ?? null })") {
        val document = JSONObject(it)
        viewTransitions.put(JSONObject().put("parent", parent).put("documentOrigin", document.get("timeOrigin").toString())
          .put("documentToken", document.get("token")))
      }
    }
    val report = JSONObject().put("generation", generation).put("resumed", resumed).put("paused", paused)
      .put("stopped", stopped).put("hostClosed", hostClosed)
      .put("retireOnPause", retireOnPause).put("permissionRetirement", permissionRetirement ?: JSONObject.NULL)
      .put("hostDestroyed", host?.destroyed ?: false)
      .put("receivedIntents", receivedIntents)
      .put("rnPermissionRequests", rnPermissionRequests).put("rnPermissionResults", rnPermissionResults)
      .put("listeners", RuntimeSession.status().getInt("listeners")).put("listenersAfterRelease", listenersAfterRelease).put("pid", android.os.Process.myPid())
    if (originalParent != null) report.put("view", JSONObject().put("originalParent", observedWebView.parent == originalParent)
      .put("parent", observedWebView.parent.javaClass.name).put("documentOrigin", documentOrigin ?: JSONObject.NULL)
      .put("documentToken", documentToken)
      .put("navigationDelegateUnchanged", observedWebView.webViewClient == originalClient)
      .put("uiDelegateUnchanged", observedWebView.webChromeClient == originalChromeClient).put("transitions", viewTransitions))
    val notes = File(applicationInfo.dataDir, "notes.json")
    report.put("notes", if (notes.exists()) org.json.JSONArray(notes.readText()) else org.json.JSONArray())
    android.util.Log.i("TauriReactAcceptance", JSONObject().put("kind", "lifecycle").put("report", report).toString())
  }
  override fun onResume() { super.onResume(); resumed++ }
  override fun requestPermissions(permissions: Array<String>, requestCode: Int, listener: PermissionListener?) {
    // Record actual delivery to the RN module, including the renderer which owned its listener.
    val owner = generation
    runOnUiThread { rnPermissionRequests.put(JSONObject().put("generation", owner).put("code", requestCode).put("permissions", org.json.JSONArray(permissions.toList()))) }
    super.requestPermissions(permissions, requestCode, PermissionListener { code, requested, grants ->
      rnPermissionResults.put(JSONObject().put("generation", owner).put("code", code).put("permissions", org.json.JSONArray(requested.toList())).put("grants", org.json.JSONArray(grants.toList())))
      record()
      listener?.onRequestPermissionsResult(code, requested, grants) ?: true
    })
  }
  override fun onPause() {
    paused++; super.onPause()
    if (retireOnPause) {
      retireOnPause = false
      reloadRenderer()
      permissionRetirement = JSONObject().put("generation", generation).put("listeners", listenersAfterRelease)
        .put("paused", paused).put("runtimeStatus", RuntimeSession.status().getString("status")).put("pid", android.os.Process.myPid())
      record()
    }
  }
  override fun onStop() { super.onStop(); stopped++; record() }
  override fun onNewIntent(intent: Intent) { super.onNewIntent(intent); receivedIntents.put(intent.dataString); record() }
  override fun onDestroy() { destroyed = true; super.onDestroy() }
}
