import { registerRootComponent } from 'expo';
import { File, Paths } from 'expo-file-system';
import Constants from 'expo-constants';
import { requireNativeModule } from 'expo-modules-core';
import { SafeAreaProvider, useSafeAreaFrame } from 'react-native-safe-area-context';
import { App as Fieldnotes, type FieldnotesAction } from './fieldnotes';

const probe = requireNativeModule<{
  snapshot(): { created: number; destroyed: number; callbacks: number; applicationCreates: number; activityCreates: number; resumes: number; pauses: number; intents: number; backs: number };
  requestLocation(): Promise<Record<string, string>>;
}>('RetainedExpoProbe');
const file = () => new File(Paths.document, 'retained-expo-note.txt');
function ExpoFieldnotes() {
  const frame = useSafeAreaFrame();
  const extraActions: FieldnotesAction[] = [
    ['Expo write file', async () => { file().write('Written by the Expo native file module'); return 'Expo file saved'; }],
    ['Expo read file', async () => {
      if (await file().text() !== 'Written by the Expo native file module') throw new Error('Expo file bytes changed');
      return 'Expo file preserved';
    }],
    ['Expo native modules', async () => {
      const state = probe.snapshot();
      if (!(frame.width > 0 && frame.height > 0) || Constants.expoConfig?.slug !== 'retained-expo-fieldnotes') throw new Error('Expo config or native SafeAreaProvider did not initialize');
      if (state.applicationCreates !== 1 || state.activityCreates !== 1 || state.created - state.destroyed !== 1) throw new Error(JSON.stringify(state));
      return `Expo native active 1 created ${state.created} destroyed ${state.destroyed} callbacks ${state.callbacks} links ${state.intents} back ${state.backs}`;
    }],
    ['Expo request permission', async () => {
      const results = await probe.requestLocation();
      const fine = results['android.permission.ACCESS_FINE_LOCATION'];
      const coarse = results['android.permission.ACCESS_COARSE_LOCATION'];
      return `Expo fine ${fine} coarse ${coarse}`;
    }],
    ['Expo request then save', async runtime => {
      const results = await probe.requestLocation();
      if (results['android.permission.ACCESS_COARSE_LOCATION'] !== 'granted') throw new Error(JSON.stringify(results));
      const saved = await runtime.invoke('save_note', { text: 'Retired Expo permission must not save', latitude: 0, longitude: 0 });
      if (!saved.ok) throw new Error(JSON.stringify(saved.error));
      return 'ERROR retired Expo permission saved';
    }],
  ];
  return <Fieldnotes extraActions={extraActions} />;
}
function App() { return <SafeAreaProvider><ExpoFieldnotes /></SafeAreaProvider>; }
registerRootComponent(App);
