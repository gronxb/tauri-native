#import <UIKit/UIKit.h>
#import <WebKit/WebKit.h>
#import <mach/mach.h>
#import <pthread.h>
#import <objc/runtime.h>
#import <TauriNativeReactRetained/TNReactComposition.h>
#import "../TauriNativeRuntime/TNRuntimeSession.h"

// Acceptance layout/readiness and telemetry only; the SDK owns launch observation and attachment.
@interface TNReactComposition (LaunchObservation)
- (void)launched:(NSNotification *)notification;
@end
@interface TNReactAcceptance : TNReactComposition
@property(nonatomic) UIView *panel;
@property(nonatomic) NSString *directory;
@property(nonatomic) NSInteger generation, resumed, paused, stopped, listenersAfterRelease;
@property(nonatomic) BOOL hostClosed, retireOnPause;
@property(nonatomic) NSDictionary *permissionRetirement;
@property(nonatomic) IMP originalOpenURL, originalUserActivity;
@property(nonatomic, weak) id<UIApplicationDelegate> originalDelegate;
@property(nonatomic) NSString *launchURL;
@property(nonatomic) BOOL unrelatedActivityHandled, browsingActivityHandled;
@property(nonatomic) NSInteger restorationCalls;
@end

@implementation TNReactAcceptance
- (void)launched:(NSNotification *)notification {
  self.launchURL = [notification.userInfo[UIApplicationLaunchOptionsURLKey] absoluteString];
  self.originalDelegate = UIApplication.sharedApplication.delegate;
  Class delegate = object_getClass(self.originalDelegate);
  self.originalOpenURL = class_getMethodImplementation(delegate, @selector(application:openURL:options:));
  self.originalUserActivity = class_getMethodImplementation(delegate, @selector(application:continueUserActivity:restorationHandler:));
  [super launched:notification];
}
- (instancetype)init {
  if ((self = [super init])) {
    self.listenersAfterRelease = -1;
    self.directory = [NSSearchPathForDirectoriesInDomains(NSApplicationSupportDirectory, NSUserDomainMask, YES).firstObject
      stringByAppendingPathComponent:NSBundle.mainBundle.bundleIdentifier];
    NSNotificationCenter *center = NSNotificationCenter.defaultCenter;
    [center addObserver:self selector:@selector(resumed:) name:UIApplicationDidBecomeActiveNotification object:nil];
    [center addObserver:self selector:@selector(paused:) name:UIApplicationWillResignActiveNotification object:nil];
    [center addObserver:self selector:@selector(stopped:) name:UIApplicationDidEnterBackgroundNotification object:nil];
  }
  return self;
}
// Own-process thread inspection verifies RN actually retires its JS engine.
- (NSArray<NSString *> *)reactThreads {
  thread_act_array_t threads; mach_msg_type_number_t count;
  if (task_threads(mach_task_self(), &threads, &count) != KERN_SUCCESS)
    [NSException raise:@"AcceptanceFailure" format:@"Cannot inspect process threads"];
  NSMutableArray *names = [NSMutableArray new];
  for (mach_msg_type_number_t i = 0; i < count; i++) {
    pthread_t thread = pthread_from_mach_thread_np(threads[i]);
    char name[64] = {0};
    if (thread && pthread_getname_np(thread, name, sizeof(name)) == 0 &&
        [[NSString stringWithUTF8String:name] hasPrefix:@"com.facebook.react.runtime.JavaScript"])
      [names addObject:[NSString stringWithUTF8String:name]];
    mach_port_deallocate(mach_task_self(), threads[i]);
  }
  vm_deallocate(mach_task_self(), (vm_address_t)threads, count * sizeof(thread_t));
  return names;
}
- (void)record {
  if (!self.generation) return;
  Class delegate = object_getClass(UIApplication.sharedApplication.delegate);
  BOOL callbacksRestored = class_getMethodImplementation(delegate, @selector(application:openURL:options:)) == self.originalOpenURL &&
    class_getMethodImplementation(delegate, @selector(application:continueUserActivity:restorationHandler:)) == self.originalUserActivity;
  NSDictionary *report = @{@"generation": @(self.generation), @"resumed": @(self.resumed), @"paused": @(self.paused), @"stopped": @(self.stopped),
    @"reactThreads": [self reactThreads], @"listeners": [TNRuntimeSession status][@"listeners"], @"listenersAfterRelease": @(self.listenersAfterRelease), @"hostClosed": @(self.hostClosed),
    @"retireOnPause": @(self.retireOnPause), @"permissionRetirement": self.permissionRetirement ?: NSNull.null,
    @"delegateUnchanged": @(self.originalDelegate == UIApplication.sharedApplication.delegate), @"urlCallbacksRestored": @(callbacksRestored),
    @"launchURL": self.launchURL ?: NSNull.null, @"unrelatedActivityHandled": @(self.unrelatedActivityHandled),
    @"browsingActivityHandled": @(self.browsingActivityHandled), @"restorationCalls": @(self.restorationCalls),
    @"pid": @(NSProcessInfo.processInfo.processIdentifier), @"appDelegate": NSStringFromClass(UIApplication.sharedApplication.delegate.class)};
  NSData *data = [NSJSONSerialization dataWithJSONObject:report options:0 error:nil];
  if (![data writeToFile:[self.directory stringByAppendingPathComponent:@"react-lifecycle.json"] atomically:YES])
    [NSException raise:@"AcceptanceFailure" format:@"Cannot write lifecycle evidence"];
}
- (void)resumed:(NSNotification *)notification { self.resumed++; [self record]; }
- (void)paused:(NSNotification *)notification {
  self.paused++;
  if (self.retireOnPause) {
    self.retireOnPause = NO;
    [self remount];
    self.permissionRetirement = @{@"generation": @(self.generation), @"listeners": @(self.listenersAfterRelease),
      @"paused": @(self.paused), @"runtimeStatus": [TNRuntimeSession status][@"status"], @"pid": @(NSProcessInfo.processInfo.processIdentifier)};
  }
  [self record];
}
- (void)stopped:(NSNotification *)notification { self.stopped++; [self record]; }
- (BOOL)isTauriDocumentReady:(WKWebView *)webview {
  if ([NSFileManager.defaultManager fileExistsAtPath:[self.directory stringByAppendingPathComponent:@"hold-react-attachment"]]) return NO;
  NSData *data = [NSData dataWithContentsOfFile:[self.directory stringByAppendingPathComponent:@"runtime-report.json"]];
  NSDictionary *baseline = data ? [NSJSONSerialization JSONObjectWithData:data options:0 error:nil] : nil;
  return [super isTauriDocumentReady:webview] && [baseline[@"passed"] boolValue];
}
- (UIView *)createReactContainer:(WKWebView *)webview {
  UIView *parent = webview.superview;
  CGRect bounds = parent.bounds;
  self.panel = [[UIView alloc] initWithFrame:CGRectMake(0, bounds.size.height / 3, bounds.size.width, bounds.size.height * 2 / 3)];
  self.panel.backgroundColor = UIColor.whiteColor;
  self.panel.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight | UIViewAutoresizingFlexibleTopMargin;
  [parent addSubview:self.panel];
  UIButton *remount = [UIButton buttonWithType:UIButtonTypeSystem];
  [remount setTitle:@"Reload RN" forState:UIControlStateNormal];
  remount.frame = CGRectMake(0, 0, bounds.size.width / 3, 44);
  [remount addTarget:self action:@selector(remount) forControlEvents:UIControlEventTouchUpInside];
  [self.panel addSubview:remount];
  UIButton *close = [UIButton buttonWithType:UIButtonTypeSystem];
  [close setTitle:@"Close RN" forState:UIControlStateNormal];
  close.frame = CGRectMake(bounds.size.width / 3, 0, bounds.size.width / 3, 44);
  [close addTarget:self action:@selector(closeHost) forControlEvents:UIControlEventTouchUpInside];
  [self.panel addSubview:close];
  UIButton *arm = [UIButton buttonWithType:UIButtonTypeSystem];
  [arm setTitle:@"Retire on pause" forState:UIControlStateNormal];
  arm.frame = CGRectMake(bounds.size.width * 2 / 3, 0, bounds.size.width / 3, 44);
  [arm addTarget:self action:@selector(armRetirement) forControlEvents:UIControlEventTouchUpInside];
  [self.panel addSubview:arm];
  UIButton *webLink = [UIButton buttonWithType:UIButtonTypeSystem];
  [webLink setTitle:@"Continue web link" forState:UIControlStateNormal];
  webLink.frame = CGRectMake(0, 44, bounds.size.width, 28);
  [webLink addTarget:self action:@selector(continueWebLink) forControlEvents:UIControlEventTouchUpInside];
  [self.panel addSubview:webLink];
  UIView *container = [[UIView alloc] initWithFrame:CGRectMake(0, 72, self.panel.bounds.size.width, self.panel.bounds.size.height - 72)];
  container.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
  [self.panel addSubview:container];
  return container;
}
- (void)reactHostDidAttach {
  [super reactHostDidAttach];
  self.generation++;
  [self telemetry];
}
- (void)armRetirement { self.retireOnPause = YES; [self record]; }
- (void)continueWebLink {
  // Inject native delegate callbacks; this does not establish OS associated-domain routing.
  UIApplication *app = UIApplication.sharedApplication;
  NSUserActivity *unrelated = [[NSUserActivity alloc] initWithActivityType:@"dev.taurinative.unrelated"];
  self.unrelatedActivityHandled = [app.delegate application:app continueUserActivity:unrelated
    restorationHandler:^(NSArray *items) { self.restorationCalls++; }];
  NSUserActivity *browsing = [[NSUserActivity alloc] initWithActivityType:NSUserActivityTypeBrowsingWeb];
  browsing.webpageURL = [NSURL URLWithString:@"https://example.invalid/tauri-native-handoff"];
  self.browsingActivityHandled = [app.delegate application:app continueUserActivity:browsing
    restorationHandler:^(NSArray *items) { self.restorationCalls++; }];
  [self record];
}
- (void)remount {
  [super reload]; self.generation++;
  self.listenersAfterRelease = [[TNRuntimeSession status][@"listeners"] integerValue];
  [self record];
}
- (void)closeHost {
  [super close]; self.hostClosed = YES;
  [self.panel removeFromSuperview];
  [self record];
}
- (void)telemetry {
  [self record];
  dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 100 * NSEC_PER_MSEC), dispatch_get_main_queue(), ^{ [self telemetry]; });
}
@end
