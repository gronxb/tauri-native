#import <UIKit/UIKit.h>
#import <WebKit/WebKit.h>
#import <mach/mach.h>
#import <pthread.h>
#import <TauriNativeReactRetained/TNReactHost.h>
#import "../TauriNativeRuntime/TNRuntimeSession.h"

// Layout and telemetry only; the packed SDK owns the module, engine and sessions.
@interface TNReactAcceptance : NSObject
+ (void)install;
@property(nonatomic) TNReactHost *host;
@property(nonatomic) UIView *panel;
@property(nonatomic) NSString *directory;
@property(nonatomic) NSInteger generation, resumed, paused, stopped, listenersAfterRelease;
@property(nonatomic) BOOL hostClosed;
@end
static TNReactAcceptance *acceptance;

@implementation TNReactAcceptance
+ (void)install {
  acceptance = [TNReactAcceptance new];
  acceptance.listenersAfterRelease = -1;
  acceptance.directory = [NSSearchPathForDirectoriesInDomains(NSApplicationSupportDirectory, NSUserDomainMask, YES).firstObject
    stringByAppendingPathComponent:NSBundle.mainBundle.bundleIdentifier];
  NSNotificationCenter *center = NSNotificationCenter.defaultCenter;
  [center addObserver:acceptance selector:@selector(launched:) name:UIApplicationDidFinishLaunchingNotification object:nil];
  [center addObserver:acceptance selector:@selector(resumed:) name:UIApplicationDidBecomeActiveNotification object:nil];
  [center addObserver:acceptance selector:@selector(paused:) name:UIApplicationWillResignActiveNotification object:nil];
  [center addObserver:acceptance selector:@selector(stopped:) name:UIApplicationDidEnterBackgroundNotification object:nil];
}
// Own-process thread inspection verifies RN actually retires its JS engine.
- (NSArray<NSString *> *)reactThreads {
  thread_act_array_t threads; mach_msg_type_number_t count;
  if (task_threads(mach_task_self(), &threads, &count) != KERN_SUCCESS)
    [NSException raise:@"AcceptanceFailure" format:@"Cannot inspect process threads"];
  NSMutableArray *names = [NSMutableArray new];
  for (mach_msg_type_number_t i = 0; i < count; i++) {
    pthread_t thread = pthread_from_mach_thread_np(threads[i]);
    char name[64] = {0};
    if (thread && pthread_getname_np(thread, name, sizeof(name)) == 0 &&
        [[NSString stringWithUTF8String:name] hasPrefix:@"com.facebook.react.runtime.JavaScript"])
      [names addObject:[NSString stringWithUTF8String:name]];
    mach_port_deallocate(mach_task_self(), threads[i]);
  }
  vm_deallocate(mach_task_self(), (vm_address_t)threads, count * sizeof(thread_t));
  return names;
}
- (void)record {
  if (!self.generation) return;
  NSDictionary *report = @{@"generation": @(self.generation), @"resumed": @(self.resumed), @"paused": @(self.paused), @"stopped": @(self.stopped),
    @"reactThreads": [self reactThreads], @"listeners": [TNRuntimeSession status][@"listeners"], @"listenersAfterRelease": @(self.listenersAfterRelease), @"hostClosed": @(self.hostClosed),
    @"pid": @(NSProcessInfo.processInfo.processIdentifier), @"appDelegate": NSStringFromClass(UIApplication.sharedApplication.delegate.class)};
  NSData *data = [NSJSONSerialization dataWithJSONObject:report options:0 error:nil];
  if (![data writeToFile:[self.directory stringByAppendingPathComponent:@"react-lifecycle.json"] atomically:YES])
    [NSException raise:@"AcceptanceFailure" format:@"Cannot write lifecycle evidence"];
}
- (void)resumed:(NSNotification *)notification { self.resumed++; [self record]; }
- (void)paused:(NSNotification *)notification { self.paused++; [self record]; }
- (void)stopped:(NSNotification *)notification { self.stopped++; [self record]; }
- (void)launched:(NSNotification *)notification { [self attachWhenReady]; }
- (WKWebView *)findWebview:(UIView *)view {
  if ([view isKindOfClass:WKWebView.class]) return (WKWebView *)view;
  for (UIView *child in view.subviews) { WKWebView *found = [self findWebview:child]; if (found) return found; }
  return nil;
}
- (void)attachWhenReady {
  WKWebView *webview;
  for (UIWindow *window in UIApplication.sharedApplication.windows) { webview = [self findWebview:window]; if (webview) break; }
  NSData *data = [NSData dataWithContentsOfFile:[self.directory stringByAppendingPathComponent:@"runtime-report.json"]];
  NSDictionary *baseline = data ? [NSJSONSerialization JSONObjectWithData:data options:0 error:nil] : nil;
  if (!webview || ![baseline[@"passed"] boolValue]) {
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 100 * NSEC_PER_MSEC), dispatch_get_main_queue(), ^{ [self attachWhenReady]; }); return;
  }
  UIView *parent = webview.superview;
  CGRect bounds = parent.bounds;
  self.panel = [[UIView alloc] initWithFrame:CGRectMake(0, bounds.size.height / 3, bounds.size.width, bounds.size.height * 2 / 3)];
  self.panel.backgroundColor = UIColor.whiteColor;
  self.panel.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight | UIViewAutoresizingFlexibleTopMargin;
  [parent addSubview:self.panel];
  UIButton *remount = [UIButton buttonWithType:UIButtonTypeSystem];
  [remount setTitle:@"Reload RN" forState:UIControlStateNormal];
  remount.frame = CGRectMake(0, 0, bounds.size.width / 2, 44);
  [remount addTarget:self action:@selector(remount) forControlEvents:UIControlEventTouchUpInside];
  [self.panel addSubview:remount];
  UIButton *close = [UIButton buttonWithType:UIButtonTypeSystem];
  [close setTitle:@"Close RN" forState:UIControlStateNormal];
  close.frame = CGRectMake(bounds.size.width / 2, 0, bounds.size.width / 2, 44);
  [close addTarget:self action:@selector(closeHost) forControlEvents:UIControlEventTouchUpInside];
  [self.panel addSubview:close];
  UIView *container = [[UIView alloc] initWithFrame:CGRectMake(0, 44, self.panel.bounds.size.width, self.panel.bounds.size.height - 44)];
  container.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
  [self.panel addSubview:container];
  NSURL *bundle = [NSBundle.mainBundle URLForResource:@"index.bundle" withExtension:@"js" subdirectory:@"assets"];
  if (!bundle) [NSException raise:@"AcceptanceFailure" format:@"Missing packed renderer bundle"];
  self.host = [[TNReactHost alloc] initWithContainer:container module:@"RetainedFieldnotes" bundle:bundle];
  self.generation++;
  [self telemetry];
}
- (void)remount {
  [self.host reload]; self.generation++;
  self.listenersAfterRelease = [[TNRuntimeSession status][@"listeners"] integerValue];
  [self record];
}
- (void)closeHost {
  [self.host close]; self.host = nil; self.hostClosed = YES;
  [self.panel removeFromSuperview];
  [self record];
}
- (void)telemetry {
  [self record];
  dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 100 * NSEC_PER_MSEC), dispatch_get_main_queue(), ^{ [self telemetry]; });
}
@end
