package dev.taurinative.mobilefieldnotes

import android.os.Bundle
import android.content.Intent
import android.webkit.WebView
import android.view.ViewGroup
import android.widget.Button
import android.widget.FrameLayout
import android.widget.LinearLayout
import android.content.res.Configuration
import dev.taurinative.react.retained.TauriReactHost
import dev.taurinative.runtime.RuntimeSession
import java.io.File
import org.json.JSONObject

// Test layout and telemetry only. The packed SDK owns the module, engine and sessions.
class MainActivity : TauriActivity() {
  private var host: TauriReactHost? = null
  private var destroyed = false
  private var generation = 0
  private var resumed = 0
  private var paused = 0
  private var stopped = 0
  private var listenersAfterRelease = -1
  private var hostClosed = false
  private val receivedIntents = org.json.JSONArray()

  override fun onCreate(savedInstanceState: Bundle?) {
    TauriReactHost.initialize(application)
    super.onCreate(savedInstanceState)
  }
  override fun onWebViewCreate(webView: WebView) {
    super.onWebViewCreate(webView)
    val attach = object : Runnable { override fun run() {
      if (destroyed) return
      val baseline = File(applicationInfo.dataDir, "runtime-report.json")
      if (webView.progress < 100 || !baseline.exists() || !JSONObject(baseline.readText()).optBoolean("passed")) { webView.postDelayed(this, 100); return }
      android.util.Log.i("TauriReactAcceptance", JSONObject().put("kind", "baseline").put("report", JSONObject(baseline.readText())).toString())
      (webView.parent as? ViewGroup)?.removeView(webView)
      val layout = LinearLayout(this@MainActivity).apply { orientation = LinearLayout.VERTICAL; setPadding(0, 80, 0, 60) }
      layout.addView(webView, LinearLayout.LayoutParams(-1, 0, 1f))
      val container = FrameLayout(this@MainActivity)
      val remount = Button(this@MainActivity).apply {
        text = "Reload RN"
        setOnClickListener {
          host!!.reload()
          generation++
          listenersAfterRelease = RuntimeSession.status().getInt("listeners")
          record()
        }
      }
      val controls = LinearLayout(this@MainActivity)
      controls.addView(remount, LinearLayout.LayoutParams(0, -2, 1f))
      val close = Button(this@MainActivity).apply {
        text = "Close RN"
        setOnClickListener {
          host!!.close(); hostClosed = true
          layout.removeView(container); layout.removeView(controls)
          record()
        }
      }
      controls.addView(close, LinearLayout.LayoutParams(0, -2, 1f))
      layout.addView(controls)
      layout.addView(container, LinearLayout.LayoutParams(-1, 0, 2f))
      setContentView(layout)
      host = TauriReactHost(this@MainActivity, container, "RetainedFieldnotes", "index.bundle.js")
      generation++; host!!.onResume(); host!!.onWindowFocusChanged(hasWindowFocus())
      val telemetry = object : Runnable { override fun run() { if (!destroyed) { record(); webView.postDelayed(this, 100) } } }
      webView.post(telemetry)
    } }
    webView.post(attach)
  }
  private fun record() {
    val report = JSONObject().put("generation", generation).put("resumed", resumed).put("paused", paused)
      .put("stopped", stopped).put("hostClosed", hostClosed).put("hostDestroyed", host?.destroyed ?: false)
      .put("receivedIntents", receivedIntents)
      .put("listeners", RuntimeSession.status().getInt("listeners")).put("listenersAfterRelease", listenersAfterRelease).put("pid", android.os.Process.myPid())
    val notes = File(applicationInfo.dataDir, "notes.json")
    report.put("notes", if (notes.exists()) org.json.JSONArray(notes.readText()) else org.json.JSONArray())
    android.util.Log.i("TauriReactAcceptance", JSONObject().put("kind", "lifecycle").put("report", report).toString())
  }
  override fun onResume() { super.onResume(); resumed++; host?.onResume() }
  override fun onPause() { host?.onPause(); paused++; super.onPause() }
  override fun onStop() { super.onStop(); stopped++; record() }
  override fun onNewIntent(intent: Intent) { super.onNewIntent(intent); host?.onNewIntent(intent); receivedIntents.put(intent.dataString); record() }
  override fun onActivityResult(request: Int, result: Int, data: Intent?) { super.onActivityResult(request, result, data); host?.onActivityResult(request, result, data) }
  override fun onWindowFocusChanged(focused: Boolean) { super.onWindowFocusChanged(focused); host?.onWindowFocusChanged(focused) }
  override fun onConfigurationChanged(config: Configuration) { super.onConfigurationChanged(config); host?.onConfigurationChanged() }
  override fun onDestroy() { destroyed = true; host?.close(); super.onDestroy() }
}
