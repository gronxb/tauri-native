{
  "name": "@tauri-native/react-native",
  "version": "1.0.0-rc.0",
  "description": "Embed a packaged Tauri microfrontend in React Native with a native-to-Rust bridge",
  "source": "./src/index.ts",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "tauri-native-source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./retained": {
      "tauri-native-source": "./src/retained.ts",
      "types": "./lib/typescript/src/retained.d.ts",
      "default": "./lib/module/retained.js"
    },
    "./app.plugin": "./app.plugin.js",
    "./app.plugin.js": "./app.plugin.js",
    "./artifacts": {
      "types": "./artifacts.d.ts",
      "default": "./artifacts.js"
    },
    "./package.json": "./package.json",
    "./retained-artifacts": {
      "types": "./retained-artifacts.d.ts",
      "default": "./retained-artifacts.js"
    },
    "./compose": {
      "types": "./compose.d.ts",
      "default": "./compose.js"
    }
  },
  "files": [
    "app.plugin.js",
    "artifacts.js",
    "artifacts.d.ts",
    "android/build.gradle",
    "android/consumer-rules.pro",
    "android/src",
    "android/retained/build.gradle",
    "android/retained/consumer-rules.pro",
    "android/retained/src",
    "retained",
    "cpp",
    "ios/*.h",
    "ios/*.m",
    "ios/*.mm",
    "ios/*.swift",
    "ios/TauriNativeReactRetained.podspec",
    "ios/retained/*.h",
    "ios/retained/*.mm",
    "ios/retained/*.rb",
    "LICENSE",
    "lib",
    "README.md",
    "RETAINED.md",
    "src",
    "*.podspec",
    "retained-artifacts.js",
    "retained-artifacts.d.ts",
    "compose.js",
    "compose.d.ts"
  ],
  "scripts": {
    "build": "node --experimental-strip-types ../../scripts/sync-host-files.ts react-native && bob build",
    "prepack": "node --experimental-strip-types ../../scripts/sync-host-files.ts react-native && bob build",
    "test": "node --experimental-strip-types ../../scripts/sync-host-files.ts react-native --check && node --experimental-strip-types --test test/*.test.ts && nub run test:package",
    "test:package": "node --experimental-strip-types ../../scripts/verify-package.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "react-native",
    "rust",
    "tauri",
    "ios",
    "android"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gronxb/tauri-native.git",
    "directory": "packages/react-native"
  },
  "homepage": "https://github.com/gronxb/tauri-native#readme",
  "bugs": {
    "url": "https://github.com/gronxb/tauri-native/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "experimental"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "TauriNativeSpec",
    "type": "all",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.reactnativetauri"
    },
    "ios": {
      "components": {
        "TauriView": {
          "className": "TNTauriView"
        }
      }
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-builder-bob": "^0.43.0",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "dependencies": {
    "@babel/runtime": "^7.25.0"
  }
}
