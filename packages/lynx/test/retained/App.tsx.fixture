import { useEffect, useRef, useState } from '@lynx-js/react';
import { openTauriSession, type RuntimeSession, type InvokeResponse } from '@tauri-native/lynx/retained';

function value<T>(response: InvokeResponse<T>): T {
  if (!response.ok) throw new Error(JSON.stringify(response.error));
  return response.value;
}

export function App() {
  const session = useRef<RuntimeSession>();
  const [status, setStatus] = useState('Opening Tauri');
  const [events, setEvents] = useState(0);
  const run = (action: (runtime: RuntimeSession) => Promise<string>) => {
    'background only';
    if (session.current) void action(session.current).then(setStatus, error => setStatus(`ERROR ${error}`));
  };
  useEffect(() => {
    let disposed = false;
    void openTauriSession('native').then(async runtime => {
      if (disposed) { await runtime.close(); return; }
      session.current = runtime;
      await runtime.listen('fieldnotes-updated', () => setEvents(count => count + 1), error => setStatus(`EVENT ERROR ${JSON.stringify(error)}`));
      const state = value(await runtime.invoke<{ value: number; setupCount: number; pluginSetupCount: number }>('snapshot', {}));
      setStatus(`Tauri ${state.value} setup ${state.setupCount} plugins ${state.pluginSetupCount}`);
    }).catch(error => { if (!disposed) setStatus(`ERROR ${error}`); });
    return () => { disposed = true; void session.current?.close(); session.current = undefined; };
  }, []);
  const actions: [string, (runtime: RuntimeSession) => Promise<string>][] = [
    ['Check permission', async runtime => {
      const permission = value(await runtime.invoke<{ location: string }>('plugin:geolocation|check_permissions', {}));
      return `Permission ${permission.location}`;
    }],
    ['Request permission', async runtime => {
      const permission = value(await runtime.invoke<{ location: string }>('plugin:geolocation|request_permissions', { permissions: ['location'] }));
      return `Permission ${permission.location}`;
    }],
    ['Deny capability', async runtime => {
      const reply = await runtime.invoke('plugin:geolocation|watch_position', { callback: 1 });
      if (reply.ok || !String(reply.error).includes('not allowed by ACL')) throw new Error(JSON.stringify(reply));
      return 'Tauri capability denied';
    }],
    ['Deny native caller', async runtime => {
      const reply = await runtime.invoke('increment', { delta: 10 });
      if (reply.ok || !String(reply.error).includes('Native caller does not allow')) throw new Error(JSON.stringify(reply));
      return 'Native caller denied';
    }],
    ['Save location', async runtime => {
      const position = await runtime.invoke<{ coords: { latitude: number; longitude: number } }>('plugin:geolocation|get_current_position', { options: { enableHighAccuracy: true, timeout: 10000, maximumAge: 0 } });
      if (!position.ok) return 'Location denied';
      const note = value(await runtime.invoke<{ id: number }>('save_note', { text: 'A Lynx place to remember', ...position.value.coords }));
      return `Lynx note ${note.id}`;
    }],
    ['Refresh Tauri', async runtime => {
      const state = value(await runtime.invoke<{ links: string[]; notes: unknown[]; setupCount: number; pluginSetupCount: number }>('plugin_snapshot', {}));
      if (state.setupCount !== 1 || state.pluginSetupCount !== 1) throw new Error(JSON.stringify(state));
      return `Links ${state.links.length} notes ${state.notes.length} setup 1 plugins 1`;
    }],
  ];
  return <view style={{ width: '100%', height: '100%', backgroundColor: '#e4f3ed', padding: '12px' }}>
    {[status, `Lynx events ${events}`].map(text => <text key={text} flatten={false} accessibility-element={true} accessibility-label={text} style={{ fontSize: '15px', color: '#12382d' }}>{text}</text>)}
    {actions.map(([label, action]) => <view key={label} flatten={false} accessibility-element={true} accessibility-label={label} bindtap={() => run(action)} style={{ marginTop: '5px', padding: '5px', backgroundColor: '#fff' }}><text>{label}</text></view>)}
  </view>;
}
