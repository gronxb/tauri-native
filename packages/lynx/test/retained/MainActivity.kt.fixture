package dev.taurinative.mobilefieldnotes

import android.os.Bundle
import android.content.Intent
import android.webkit.WebView
import android.view.ViewGroup
import android.widget.Button
import android.widget.FrameLayout
import android.widget.LinearLayout
import com.lynx.tasm.provider.AbsTemplateProvider
import dev.taurinative.lynx.retained.TauriLynxHost
import dev.taurinative.runtime.RuntimeSession
import java.io.File
import org.json.JSONObject

// Test layout and telemetry only. The packed SDK owns the module, engine and sessions.
class MainActivity : TauriActivity() {
  private var host: TauriLynxHost? = null
  private var destroyed = false
  private var generation = 0
  private var resumed = 0
  private var paused = 0
  private var stopped = 0
  private var listenersAfterRelease = -1
  private val receivedIntents = org.json.JSONArray()

  override fun onCreate(savedInstanceState: Bundle?) {
    TauriLynxHost.initialize(application)
    super.onCreate(savedInstanceState)
  }
  override fun onWebViewCreate(webView: WebView) {
    super.onWebViewCreate(webView)
    val attach = object : Runnable { override fun run() {
      if (destroyed) return
      val baseline = File(applicationInfo.dataDir, "runtime-report.json")
      if (webView.progress < 100 || !baseline.exists() || !JSONObject(baseline.readText()).optBoolean("passed")) { webView.postDelayed(this, 100); return }
      android.util.Log.i("TauriLynxAcceptance", JSONObject().put("kind", "baseline").put("report", JSONObject(baseline.readText())).toString())
      (webView.parent as? ViewGroup)?.removeView(webView)
      val layout = LinearLayout(this@MainActivity).apply { orientation = LinearLayout.VERTICAL; setPadding(0, 80, 0, 60) }
      layout.addView(webView, LinearLayout.LayoutParams(-1, 0, 1f))
      val container = FrameLayout(this@MainActivity)
      val remount = Button(this@MainActivity).apply {
        text = "Remount Lynx"
        setOnClickListener {
          host!!.reload()
          generation++
          listenersAfterRelease = RuntimeSession.status().getInt("listeners")
          record()
        }
      }
      layout.addView(remount)
      layout.addView(container, LinearLayout.LayoutParams(-1, 0, 2f))
      setContentView(layout)
      host = TauriLynxHost(container, object : AbsTemplateProvider() {
        override fun loadTemplate(uri: String, callback: Callback) { callback.onSuccess(assets.open(uri).use { it.readBytes() }) }
      }, "main.lynx.bundle")
      generation++; host!!.onResume()
      val telemetry = object : Runnable { override fun run() { if (!destroyed) { record(); webView.postDelayed(this, 100) } } }
      webView.post(telemetry)
    } }
    webView.post(attach)
  }
  private fun record() {
    val report = JSONObject().put("generation", generation).put("resumed", resumed).put("paused", paused)
      .put("stopped", stopped)
      .put("receivedIntents", receivedIntents)
      .put("listeners", RuntimeSession.status().getInt("listeners")).put("listenersAfterRelease", listenersAfterRelease).put("pid", android.os.Process.myPid())
    val notes = File(applicationInfo.dataDir, "notes.json")
    report.put("notes", if (notes.exists()) org.json.JSONArray(notes.readText()) else org.json.JSONArray())
    android.util.Log.i("TauriLynxAcceptance", JSONObject().put("kind", "lifecycle").put("report", report).toString())
  }
  override fun onResume() { super.onResume(); resumed++; host?.onResume() }
  override fun onPause() { host?.onPause(); paused++; super.onPause() }
  override fun onStop() { super.onStop(); stopped++; record() }
  override fun onNewIntent(intent: Intent) { super.onNewIntent(intent); receivedIntents.put(intent.dataString); record() }
  override fun onDestroy() { destroyed = true; host?.close(); super.onDestroy() }
}
