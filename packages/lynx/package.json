{
  "name": "@tauri-native/lynx",
  "version": "1.0.0-rc.0",
  "description": "Embed a packaged Tauri microfrontend in Lynx and invoke its Rust core",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.ts"
    },
    "./retained": {
      "types": "./src/retained.ts",
      "default": "./src/retained.ts"
    },
    "./lynx.lib.json": "./lynx.lib.json",
    "./package.json": "./package.json",
    "./artifacts": {
      "types": "./artifacts.d.ts",
      "default": "./artifacts.cjs"
    }
  },
  "files": [
    "artifacts.cjs",
    "artifacts.d.ts",
    "android/build.gradle",
    "android/consumer-rules.pro",
    "android/src",
    "android/retained",
    "generated",
    "ios/src",
    "ios/retained",
    "ios/*.podspec",
    "LICENSE",
    "src",
    "types",
    "lynx.lib.json",
    "README.md",
    "RETAINED.md"
  ],
  "scripts": {
    "build": "node --experimental-strip-types ../../scripts/sync-host-files.ts lynx && nub run codegen && tsc --noEmit",
    "codegen": "lynx-autolink-codegen",
    "prepack": "node --experimental-strip-types ../../scripts/sync-host-files.ts lynx && lynx-autolink-codegen && tsc --noEmit",
    "test": "node --experimental-strip-types ../../scripts/sync-host-files.ts lynx --check && node --experimental-strip-types --test test/*.test.ts && nub run build && nub run test:package",
    "test:package": "node --experimental-strip-types ../../scripts/verify-package.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "android",
    "ios",
    "lynx",
    "rust",
    "tauri"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gronxb/tauri-native.git",
    "directory": "packages/lynx"
  },
  "homepage": "https://github.com/gronxb/tauri-native#readme",
  "bugs": {
    "url": "https://github.com/gronxb/tauri-native/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "experimental"
  },
  "peerDependencies": {
    "@lynx-js/react": "*",
    "@lynx-js/types": "*"
  },
  "devDependencies": {
    "@lynx-js/autolink-codegen": "^0.4.1",
    "@lynx-js/react": "^0.125.0",
    "@lynx-js/types": "4.1.0",
    "typescript": "7.0.2"
  }
}
